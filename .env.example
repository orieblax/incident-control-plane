# Database (Supavisor Transaction Pooler, port 6543, for Serverless Runtime)
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Optional direct connection for CLI/alembic migrations (port 5432)
DIRECT_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase Auth & Project Metadata
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Vector Embeddings (http: openai | ai_gateway | gemini | deterministic)
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BASE_URL=https://api.openai.com/v1

# MCP & Security
MCP_STATELESS_HTTP=true
ENABLE_MCP_OAUTH_DISCOVERY=false
APPROVAL_SIGNING_SECRET=change-me-to-a-32-plus-byte-random-secret
APPROVAL_TTL_SECONDS=600
MCP_SERVICE_TOKEN=
APP_BASE_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO
